{
  "$comment": [
    "Standing authorization for this workspace. Shell, git and gh operations that are part",
    "of the requested work run without a prompt. Only operations whose effect is to destroy",
    "existing work still ask, once, with the exact command visible.",
    "Precedence in Claude Code is deny > ask > allow, so the ask patterns below win over the",
    "broad allow entries even though both match."
  ],
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__custom-tools__bash",
      "mcp__custom-tools__read",
      "mcp__custom-tools__write",
      "mcp__custom-tools__edit",
      "mcp__custom-tools__find",
      "mcp__custom-tools__grep",
      "mcp__custom-tools__ls"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(shred:*)",
      "Bash(truncate:*)",
      "Bash(dd:*)",
      "Bash(:*find:* -delete*)",
      "Bash(:*find:* -exec rm*)",
      "Bash(:*xargs rm*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git restore:*)",
      "Bash(git checkout --:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git tag -d:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push:* --delete*)",
      "Bash(git push:* :*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git worktree remove:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh release delete:*)",
      "Bash(gh release delete-asset:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh pr close:*)",
      "Bash(gh cache delete:*)",
      "Bash(gh secret delete:*)",
      "Bash(gh variable delete:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(gh api:* -X DELETE*)"
    ]
  }
}
